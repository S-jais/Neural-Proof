# =============================================================================
# Neural Proof: Environment Variables Configuration
# Copy this file to .env and populate your credentials.
# NEVER commit the .env file with real secrets!
# =============================================================================

# --- Server Secrets (Mandatory for live verification) ---
# TinyFish API key for live web search and page fetching (get at https://www.tinyfish.ai)
TINYFISH_API_KEY=

# LLM API key for claim extraction, answer generation, and evaluation (e.g. OpenAI or Anthropic)
LLM_API_KEY=

# Internal shared secret for Spring Boot to FastAPI authentication
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-secret

# --- Database Credentials (PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/neural_proof
DATABASE_USERNAME=neural
DATABASE_PASSWORD=proof_secret

# --- AI & Provider Configuration ---
# Options: openai, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- TinyFish Settings ---
# Enable selective escalation to TinyFish Agent for complex claims behind interactive sites (Part D8)
TINYFISH_AGENT_ENABLED=false
# Offline mock mode for local frontend development only (refused when APP_ENV=production)
TINYFISH_MOCK=false

# --- Application Environment ---
# Options: development, production
APP_ENV=development

# --- Service Network Endpoints ---
PYTHON_BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Cost Management & Budget Limits (Part D11) ---
MAX_CLAIMS_PER_RUN=12
QUERIES_PER_CLAIM=2
MAX_SEARCH_RESULTS_PER_CLAIM=8
MAX_FETCH_PER_CLAIM=3
MAX_AGENT_CALLS_PER_RUN=2
TINYFISH_MAX_CONCURRENCY=4
CLAIM_CONCURRENCY=3
FETCH_CACHE_TTL_SECONDS=3600
MAX_CONTENT_CHARS_PER_SOURCE=60000

# --- Timeouts (seconds) ---
TINYFISH_CONNECT_TIMEOUT_SECONDS=10
TINYFISH_SEARCH_TIMEOUT_SECONDS=30
TINYFISH_FETCH_TIMEOUT_SECONDS=160
TINYFISH_AGENT_TIMEOUT_SECONDS=120
RUN_TOTAL_TIMEOUT_SECONDS=480

# --- Input Validation Limits (Part C1) ---
INPUT_MIN_CHARS_ANSWER=40
INPUT_MAX_CHARS_ANSWER=12000
INPUT_MIN_CHARS_QUESTION=10
INPUT_MAX_CHARS_QUESTION=1000
INPUT_MAX_CHARS_CONTEXT=600

# --- Benchmark Evaluation Mode ---
ENABLE_REVIEW_LABELS=false
